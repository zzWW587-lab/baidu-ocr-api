{
  "version": 2,
  "builds": [
    {
      "src": "api/ocr.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/ocr.js"
    },
    {
      "src": "/api/ocr",
      "dest": "/api/ocr.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ocr.js"
    }
  ]
}